{
  "name": "papaquebec",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run proto && bunx --bun vite",
    "map": "bun scripts/build-coast.ts && bun scripts/build-aero.ts",
    "proto": "bunx --bun buf generate ../proto --template buf.gen.yaml",
    "schema": "bun scripts/build-schema.ts",
    "icons": "bun scripts/build-icons.ts",
    "build": "bun run proto && bun run schema && bun run icons && bunx --bun tsc --noEmit && bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "bench": "bun run build --minify false && bun scripts/bench.ts",
    "screenshot": "bun run build && bun scripts/screenshot.ts --sim 10 --wait 15000 --select TEST01 --hint --scale 1 --out ../docs/screenshot.png",
    "test": "bun run proto && bun test",
    "lint": "bun run proto && bunx --bun oxlint --type-aware",
    "format": "cd .. && bun scope/node_modules/oxfmt/bin/oxfmt",
    "format:check": "cd .. && bun scope/node_modules/oxfmt/bin/oxfmt --check"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "solid-js": "^1.9.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/bun": "latest",
    "@webgpu/types": "^0.1.74",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-solid": "^2.11.14"
  }
}
